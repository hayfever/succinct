{
  "description": "Load the succinct ruleset at session start while $CODEX_HOME/.succinct-always exists. $succinct on creates the flag and $succinct off deletes it. Codex uses this file instead of hooks/hooks.json: Codex reads the plugin path from the PLUGIN_ROOT environment variable rather than substituting it into the command text, and its default Windows shell is cmd.exe.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/always-on.sh\" --codex; exit 0",
            "commandWindows": "if exist \"%CLAUDE_PLUGIN_ROOT%\\hooks\\always-on.ps1\" powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%CLAUDE_PLUGIN_ROOT%\\hooks\\always-on.ps1\" -SkipShellCheck -Codex & exit /b 0",
            "timeout": 30,
            "statusMessage": "Checking succinct always-on flag..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/toggle.sh\" --codex; exit 0",
            "commandWindows": "if exist \"%CLAUDE_PLUGIN_ROOT%\\hooks\\toggle.ps1\" powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"%CLAUDE_PLUGIN_ROOT%\\hooks\\toggle.ps1\" -SkipShellCheck -Codex & exit /b 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
