{
  "description": "Load the succinct ruleset at session start while the .succinct-always flag exists. /succinct on creates the flag and /succinct off deletes it.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/always-on.sh\"; powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command 'if (Test-Path -LiteralPath \"${CLAUDE_PLUGIN_ROOT}/hooks/always-on.ps1\" -PathType Leaf) { & \"${CLAUDE_PLUGIN_ROOT}/hooks/always-on.ps1\" }'; exit 0",
            "timeout": 30,
            "statusMessage": "Checking succinct always-on flag..."
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^succinct(:succinct)?$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/toggle.sh\"; powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command 'if (Test-Path -LiteralPath \"${CLAUDE_PLUGIN_ROOT}/hooks/toggle.ps1\" -PathType Leaf) { & \"${CLAUDE_PLUGIN_ROOT}/hooks/toggle.ps1\" }'; exit 0",
            "timeout": 30,
            "statusMessage": "Saving the succinct choice..."
          }
        ]
      }
    ]
  }
}
